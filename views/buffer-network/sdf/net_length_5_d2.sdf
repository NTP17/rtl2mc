// 1 ns = 1 game tick. Route delay 0 at completed-tick resolution only.
(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "conn_net_length_5_d2")
  (VENDOR "sv2rt")
  (PROGRAM "checked network exporter")
  (VERSION "1")
  (DIVIDER /)
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "conn_net_length_5_d2")
    (INSTANCE)
    (DELAY (ABSOLUTE
      (INTERCONNECT A n0/A (0:0:0) (0:0:0))
      (INTERCONNECT n0/Y n1/A (0:0:0) (0:0:0))
      (INTERCONNECT n1/Y n2/A (0:0:0) (0:0:0))
    ))
  )
  (CELL
    (CELLTYPE "RNETBUF2")
    (INSTANCE n0)
    (DELAY (ABSOLUTE (IOPATH A Y (2:2:2) (2:2:2))))
    (TIMINGCHECK (WIDTH (posedge A) (3:3:3)) (WIDTH (negedge A) (3:3:3)))
  )
  (CELL
    (CELLTYPE "RNETBUF4")
    (INSTANCE n1)
    (DELAY (ABSOLUTE (IOPATH A Y (4:4:4) (4:4:4))))
    (TIMINGCHECK (WIDTH (posedge A) (5:5:5)) (WIDTH (negedge A) (5:5:5)))
  )
  (CELL
    (CELLTYPE "RNETBUF2")
    (INSTANCE n2)
    (DELAY (ABSOLUTE (IOPATH A Y (2:2:2) (2:2:2))))
    (TIMINGCHECK (WIDTH (posedge A) (3:3:3)) (WIDTH (negedge A) (3:3:3)))
  )
)
