// Abstract scale: 1 ns = 1 game tick, not elapsed nanoseconds.
(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "buffer_bank")
  (VENDOR "sv2rt")
  (PROGRAM "guarded buffer exporter")
  (VERSION "1")
  (DIVIDER /)
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "RSBUF2")
    (INSTANCE u2)
    (DELAY (ABSOLUTE (IOPATH A Y (2:2:2) (2:2:2))))
    (TIMINGCHECK
      (WIDTH (posedge A) (3:3:3))
      (WIDTH (negedge A) (3:3:3)))
  )
  (CELL
    (CELLTYPE "RSBUF4")
    (INSTANCE u4)
    (DELAY (ABSOLUTE (IOPATH A Y (4:4:4) (4:4:4))))
    (TIMINGCHECK
      (WIDTH (posedge A) (5:5:5))
      (WIDTH (negedge A) (5:5:5)))
  )
  (CELL
    (CELLTYPE "RSBUF6")
    (INSTANCE u6)
    (DELAY (ABSOLUTE (IOPATH A Y (6:6:6) (6:6:6))))
    (TIMINGCHECK
      (WIDTH (posedge A) (7:7:7))
      (WIDTH (negedge A) (7:7:7)))
  )
  (CELL
    (CELLTYPE "RSBUF8")
    (INSTANCE u8)
    (DELAY (ABSOLUTE (IOPATH A Y (8:8:8) (8:8:8))))
    (TIMINGCHECK
      (WIDTH (posedge A) (9:9:9))
      (WIDTH (negedge A) (9:9:9)))
  )
)
